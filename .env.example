# Copy to .env and fill in. docker compose reads .env automatically.
# Never put a real key in THIS file -- it is meant to be committed.
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides
# ANTHROPIC_MODEL=claude-sonnet-5     # faster and cheaper than the default opus
# RENDER_RESOLUTION=540x960           # draft size, roughly 4x faster
# STUDIO_PORT=8080
